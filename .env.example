# Names only. Real values stay on CT 136 in /etc/karakeep/karakeep.env
# and in Dashlane. Do not commit values.
NEXTAUTH_URL=https://karakeep.yingson.com
NEXTAUTH_SECRET=
DATA_DIR=/opt/karakeep_data
MEILI_ADDR=http://127.0.0.1:7700
MEILI_MASTER_KEY=
BROWSER_WEB_URL=http://127.0.0.1:9222
DB_WAL_MODE=true

# Optional. Not enabled on the first install.
# OLLAMA_BASE_URL=http://192.168.30.104:11434
# OLLAMA_KEEP_ALIVE=5m
# INFERENCE_TEXT_MODEL=
# INFERENCE_ENABLE_AUTO_TAGGING=true
