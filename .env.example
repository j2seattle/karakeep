# Names only. Real values stay on CT 136 in /etc/karakeep/karakeep.env
# and in Dashlane. Do not commit values.
NEXTAUTH_URL=https://karakeep.yingson.com
NEXTAUTH_SECRET=
DATA_DIR=/opt/karakeep_data
MEILI_ADDR=http://127.0.0.1:7700
MEILI_MASTER_KEY=
BROWSER_WEB_URL=http://127.0.0.1:9222
DB_WAL_MODE=true

# Tagging. The key is the OpenRouter key, not the Cursor key.
# Laptop copy: C:\Users\thedu\.cursor\mcps\karakeep-openrouter.env
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
INFERENCE_TEXT_MODEL=google/gemini-2.5-flash-lite
INFERENCE_IMAGE_MODEL=google/gemini-2.5-flash-lite
